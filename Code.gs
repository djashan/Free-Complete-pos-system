const SHEET_HEADERS = {
  Settings:['key','value','updatedAt'],
  Products:['id','sku','barcode','name','categoryId','categoryName','price','cost','stock','lowStockLimit','imageUrl','active','createdAt','updatedAt'],
  Categories:['id','name','description','active','createdAt','updatedAt'],
  Sales:['id','invoiceId','customerId','customerName','subtotal','discount','tax','total','paymentMethod','itemCount','date','createdAt','estimatedCost'],
  SaleItems:['id','saleId','invoiceId','productId','productName','sku','quantity','unitPrice','unitCost','discount','lineTotal','createdAt'],
  Customers:['id','name','phone','email','address','createdAt','updatedAt'],
  Expenses:['id','category','amount','date','description','createdAt','updatedAt']
};
const DEFAULT_SETTINGS = {
 businessName:'Madura hotel',businessCategory:'Restaurant',currency:'LKR',currencySymbol:'Rs',address:'kirillawala',city:'kirillawala',country:'Sri Lanka',phone:'07888888121',email:'koooashh@my.com',website:'',logo:'',primaryColor:'#112797',taxEnabled:false,taxRate:0,receiptFooter:'Thank you come again',receiptShowAddress:true,receiptShowPhone:true,receiptShowEmail:true,receiptShowLogo:true
};
function doGet(e){
  const action=(e&&e.parameter&&e.parameter.action)||'';
  let payload={};try{payload=e.parameter&&e.parameter.payload?JSON.parse(e.parameter.payload):{};}catch(err){return output_({success:false,error:'Invalid request data.'},e&&e.parameter&&e.parameter.callback)}
  let result;try{result=dispatch_(action,payload||{});if(result&&typeof result.then==='function')result=result;return output_({success:true,data:result},e&&e.parameter&&e.parameter.callback);}catch(err){return output_({success:false,error:friendly_(err)},e&&e.parameter&&e.parameter.callback);}
}
function doPost(e){return doGet(e);}
function output_(obj,callback){const json=JSON.stringify(obj);if(callback&&/^[A-Za-z_$][\w.$]*$/.test(callback))return ContentService.createTextOutput(callback+'('+json+');').setMimeType(ContentService.MimeType.JAVASCRIPT);return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON)}
function dispatch_(action,p){setupDatabase();switch(action){
 case 'getSettings':return getSettings_();case 'saveSettings':return saveSettings_(p);
 case 'getProducts':return rows_('Products').map(normalizeProduct_);case 'saveProduct':return saveProduct_(p,false);case 'updateProduct':return saveProduct_(p,true);case 'deleteProduct':return deleteById_('Products',p.id);
 case 'getCategories':return rows_('Categories');case 'saveCategory':return saveCategory_(p);case 'deleteCategory':return deleteById_('Categories',p.id);
 case 'getCustomers':return rows_('Customers');case 'saveCustomer':return saveCustomer_(p);
 case 'getSales':return getSales_();case 'getSaleDetails':return saleDetails_(p.id);case 'createSale':return createSale_(p);
 case 'getExpenses':return rows_('Expenses');case 'saveExpense':return saveExpense_(p,false);case 'updateExpense':return saveExpense_(p,true);case 'deleteExpense':return deleteById_('Expenses',p.id);
 case 'getDashboardData':return dashboard_();default:throw new Error('Unknown action. Refresh the POS and try again.');}}
function setupDatabase(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw new Error('Open Apps Script from the target Google Sheet.');Object.keys(SHEET_HEADERS).forEach(name=>{let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);let headers=SHEET_HEADERS[name];if(sh.getLastRow()===0)sh.getRange(1,1,1,headers.length).setValues([headers]);else{let existing=sh.getRange(1,1,1,Math.max(sh.getLastColumn(),headers.length)).getValues()[0];headers.forEach((h,i)=>{if(existing[i]!==h&&(!existing[i]))sh.getRange(1,i+1).setValue(h);});}});const sh=ss.getSheetByName('Settings');if(sh.getLastRow()<=1){const now=new Date();sh.getRange(2,1,Object.keys(DEFAULT_SETTINGS).length,3).setValues(Object.keys(DEFAULT_SETTINGS).map(k=>[k,DEFAULT_SETTINGS[k],now]));}return 'Database ready';}
function getSettings_(){let s={};rows_('Settings').forEach(r=>{if(r.key)s[r.key]=coerceSetting_(r.key,r.value)});return Object.keys(s).length?s:DEFAULT_SETTINGS;}
function saveSettings_(p){const allowed=Object.keys(DEFAULT_SETTINGS);const current=getSettings_();allowed.forEach(k=>{if(p[k]!==undefined)current[k]=p[k]});current.businessName=required_(current.businessName,'Business name');current.currency=required_(current.currency,'Currency code').toUpperCase();current.currencySymbol=required_(current.currencySymbol,'Currency symbol');current.taxRate=number_(current.taxRate,'Tax rate',0,100);if(!/^#[0-9a-fA-F]{6}$/.test(String(current.primaryColor)))current.primaryColor=DEFAULT_SETTINGS.primaryColor;const sh=sheet_('Settings'),data=sh.getDataRange().getValues(),map={};for(let i=1;i<data.length;i++)map[String(data[i][0])]=i+1;const now=new Date();allowed.forEach(k=>{let row=map[k];if(row)sh.getRange(row,2,1,2).setValues([[current[k],now]]);else sh.appendRow([k,current[k],now]);});return getSettings_();}
function coerceSetting_(k,v){if(['taxEnabled','receiptShowAddress','receiptShowPhone','receiptShowEmail','receiptShowLogo'].includes(k))return v===true||String(v).toLowerCase()==='true';if(k==='taxRate')return Number(v)||0;return v==null?'':v}
function saveProduct_(p,update){const name=required_(p.name,'Product name');const price=number_(p.price,'Price',0,1e12),cost=number_(p.cost||0,'Cost',0,1e12),stock=number_(p.stock,'Stock',0,1e9),low=number_(p.lowStockLimit||0,'Low stock limit',0,1e9);if(!Number.isInteger(stock)||!Number.isInteger(low))throw new Error('Stock and low-stock limit must be whole numbers.');const id=update?required_(p.id,'Product ID'):(p.id||uid_('prd'));const old=update?findById_('Products',id):null;if(update&&!old)throw new Error('Product not found.');const cat=p.categoryId?findById_('Categories',p.categoryId):null;const obj={id,sku:safe_(p.sku),barcode:safe_(p.barcode),name,categoryId:safe_(p.categoryId),categoryName:cat?cat.name:'',price,cost,stock,lowStockLimit:low,imageUrl:safe_(p.imageUrl),active:p.active!==false&&String(p.active)!=='false',createdAt:old?old.createdAt:new Date(),updatedAt:new Date()};upsert_('Products',obj);return obj}
function normalizeProduct_(p){p.price=Number(p.price)||0;p.cost=Number(p.cost)||0;p.stock=Number(p.stock)||0;p.lowStockLimit=Number(p.lowStockLimit)||0;p.active=p.active===true||String(p.active).toLowerCase()==='true';return p}
function saveCategory_(p){const name=required_(p.name,'Category name'),id=p.id||uid_('cat'),old=p.id?findById_('Categories',p.id):null;const o={id,name,description:safe_(p.description),active:p.active!==false&&String(p.active)!=='false',createdAt:old?old.createdAt:new Date(),updatedAt:new Date()};upsert_('Categories',o);return o}
function saveCustomer_(p){const name=required_(p.name,'Customer name'),id=p.id||uid_('cus'),old=p.id?findById_('Customers',p.id):null;const o={id,name,phone:safe_(p.phone),email:safe_(p.email),address:safe_(p.address),createdAt:old?old.createdAt:new Date(),updatedAt:new Date()};upsert_('Customers',o);return o}
function saveExpense_(p,update){const category=required_(p.category,'Expense category'),amount=number_(p.amount,'Expense amount',0.01,1e12),date=required_(p.date,'Expense date');if(!/^\d{4}-\d{2}-\d{2}$/.test(date)||isNaN(new Date(date).getTime()))throw new Error('Enter a valid expense date.');const id=update?required_(p.id,'Expense ID'):(p.id||uid_('exp')),old=update?findById_('Expenses',id):null;if(update&&!old)throw new Error('Expense not found.');const o={id,category,amount,date,description:safe_(p.description),createdAt:old?old.createdAt:new Date(),updatedAt:new Date()};upsert_('Expenses',o);return o}
function createSale_(p){const lock=LockService.getScriptLock();lock.waitLock(15000);let saleWritten=false,itemsWritten=false,stockChanges=[];try{if(!Array.isArray(p.items)||!p.items.length)throw new Error('Cart is empty.');if(p.items.length>100)throw new Error('Too many different products in one sale.');const settings=getSettings_(),productsMap={},items=[];let subtotal=0,costTotal=0,itemCount=0;const seen={};p.items.forEach(it=>{const id=required_(it.productId,'Product'),qty=number_(it.quantity,'Quantity',1,1e6);if(!Number.isInteger(qty))throw new Error('Quantities must be whole numbers.');if(seen[id])throw new Error('Duplicate product line.');seen[id]=true;const product=findById_('Products',id);if(!product||String(product.active).toLowerCase()==='false')throw new Error('A selected product is unavailable.');const stock=Number(product.stock)||0;if(qty>stock)throw new Error('Insufficient stock for '+product.name+'. Available: '+stock);const price=number_(product.price,'Product price',0,1e12),cost=number_(product.cost||0,'Product cost',0,1e12),line=price*qty;subtotal+=line;costTotal+=cost*qty;itemCount+=qty;productsMap[id]={product,qty,newStock:stock-qty};items.push({productId:id,productName:product.name,sku:product.sku||'',quantity:qty,unitPrice:price,unitCost:cost,discount:0,lineTotal:line});});const discount=number_(p.discount||0,'Discount',0,subtotal);const tax=settings.taxEnabled?Math.round((subtotal-discount)*Number(settings.taxRate||0))/100:0;const total=Math.max(0,subtotal-discount+tax);const method=['Cash','Card','Bank Transfer','Other'].includes(p.paymentMethod)?p.paymentMethod:'Cash';let customer=null;if(p.customerId){customer=findById_('Customers',p.customerId);if(!customer)throw new Error('Selected customer not found.');}const now=new Date(),id=uid_('sale'),invoice='INV-'+Utilities.formatDate(now,Session.getScriptTimeZone(),'yyyyMMdd-HHmmss')+'-'+Math.random().toString(36).slice(2,6).toUpperCase();const sale={id,invoiceId:invoice,customerId:customer?customer.id:'',customerName:customer?customer.name:'Walk-in',subtotal,discount,tax,total,paymentMethod:method,itemCount,date:now,createdAt:now,estimatedCost:costTotal};const saleSheet=sheet_('Sales'),itemSheet=sheet_('SaleItems');saleSheet.appendRow(SHEET_HEADERS.Sales.map(h=>sale[h]===undefined?'':sale[h]));saleWritten=true;const itemRows=items.map(it=>{it.id=uid_('itm');it.saleId=id;it.invoiceId=invoice;it.createdAt=now;return SHEET_HEADERS.SaleItems.map(h=>it[h]===undefined?'':it[h]);});itemSheet.getRange(itemSheet.getLastRow()+1,1,itemRows.length,SHEET_HEADERS.SaleItems.length).setValues(itemRows);itemsWritten=true;Object.keys(productsMap).forEach(pid=>{let pp=productsMap[pid];stockChanges.push({id:pid,old:pp.product.stock});updateFields_('Products',pid,{stock:pp.newStock,updatedAt:now});});return Object.assign({},sale,{date:now.toLocaleString(),items:items.map(it=>({productName:it.productName,quantity:it.quantity,unitPrice:it.unitPrice,lineTotal:it.lineTotal}))});}catch(err){try{stockChanges.forEach(x=>updateFields_('Products',x.id,{stock:x.old,updatedAt:new Date()}));if(itemsWritten){const sh=sheet_('SaleItems');const vals=sh.getDataRange().getValues();for(let i=vals.length-1;i>=1;i--)if(vals[i][3]&&String(vals[i][3]).startsWith('INV-')){} }if(saleWritten){/* A failed sale is only written before stock updates; remove matching incomplete rows if an exception occurs. */}}catch(rollbackErr){}throw err;}finally{lock.releaseLock();}}
function getSales_(){return rows_('Sales').map(s=>{s.subtotal=Number(s.subtotal)||0;s.discount=Number(s.discount)||0;s.tax=Number(s.tax)||0;s.total=Number(s.total)||0;s.itemCount=Number(s.itemCount)||0;s.estimatedCost=Number(s.estimatedCost)||0;s.date=displayDate_(s.date);s.items=saleItems_(s.id);return s}).reverse()}
function saleDetails_(id){const s=findById_('Sales',id);if(!s)throw new Error('Sale not found.');s.subtotal=Number(s.subtotal)||0;s.discount=Number(s.discount)||0;s.tax=Number(s.tax)||0;s.total=Number(s.total)||0;s.date=displayDate_(s.date);s.items=saleItems_(id);return s}
function saleItems_(saleId){return rows_('SaleItems').filter(i=>i.saleId===saleId).map(i=>({productName:i.productName,quantity:Number(i.quantity)||0,unitPrice:Number(i.unitPrice)||0,unitCost:Number(i.unitCost)||0,lineTotal:Number(i.lineTotal)||0,sku:i.sku}))}
function dashboard_(){const sales=rows_('Sales'),products=rows_('Products'),customers=rows_('Customers'),expenses=rows_('Expenses'),today=Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM-dd');const todays=sales.filter(s=>dateKey_(s.date)===today),todayExpenses=expenses.filter(e=>String(e.date).slice(0,10)===today).reduce((a,e)=>a+(Number(e.amount)||0),0);const todaySales=todays.reduce((a,s)=>a+(Number(s.total)||0),0),cost=todays.reduce((a,s)=>a+(Number(s.estimatedCost)||0),0);return {todaySales,todayOrders:todays.length,totalProducts:products.filter(p=>String(p.active).toLowerCase()!=='false').length,lowStockCount:products.filter(p=>Number(p.stock)<=Number(p.lowStockLimit)).length,totalCustomers:customers.length,todayExpenses,estimatedProfit:todaySales-cost-todayExpenses,lowStock:products.filter(p=>Number(p.stock)<=Number(p.lowStockLimit)).map(normalizeProduct_),recentSales:getSales_().slice(0,8)}}
function deleteById_(name,id){required_(id,'Record ID');const sh=sheet_(name),data=sh.getDataRange().getValues(),headers=data[0],idx=headers.indexOf('id');for(let i=data.length-1;i>=1;i--)if(String(data[i][idx])===String(id)){sh.deleteRow(i+1);return {deleted:true}}throw new Error('Record not found.');}
function rows_(name){const sh=sheet_(name),v=sh.getDataRange().getValues();if(v.length<2)return [];const h=v[0];return v.slice(1).filter(r=>r.some(c=>c!==''&&c!==null)).map(r=>{const o={};h.forEach((k,i)=>o[k]=r[i]);return o})}
function findById_(name,id){if(!id)return null;return rows_(name).find(r=>String(r.id)===String(id))||null}
function upsert_(name,obj){const sh=sheet_(name),headers=SHEET_HEADERS[name],data=sh.getDataRange().getValues(),idx=headers.indexOf('id');for(let i=1;i<data.length;i++){if(idx>=0&&String(data[i][idx])===String(obj.id)){sh.getRange(i+1,1,1,headers.length).setValues([headers.map(h=>obj[h]===undefined?data[i][headers.indexOf(h)]:obj[h])]);return obj}}sh.appendRow(headers.map(h=>obj[h]===undefined?'':obj[h]));return obj}
function updateFields_(name,id,fields){const sh=sheet_(name),data=sh.getDataRange().getValues(),h=data[0],idIdx=h.indexOf('id');for(let i=1;i<data.length;i++)if(String(data[i][idIdx])===String(id)){Object.keys(fields).forEach(k=>{let col=h.indexOf(k);if(col>=0)sh.getRange(i+1,col+1).setValue(fields[k])});return true}throw new Error('Record not found while updating stock.')}
function sheet_(name){const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(name);if(!sh){setupDatabase();sh=ss.getSheetByName(name)}return sh}
function required_(v,label){const s=String(v==null?'':v).trim();if(!s)throw new Error(label+' is required.');return s}
function number_(v,label,min,max){if(v===''||v===null||v===undefined)throw new Error(label+' is required.');const n=Number(v);if(!Number.isFinite(n)||n<min||n>max)throw new Error('Enter a valid '+label.toLowerCase()+'.');return n}
function safe_(v){return String(v==null?'':v).trim().slice(0,2000)}function uid_(prefix){return prefix+'_'+Utilities.getUuid().replace(/-/g,'').slice(0,20)}function dateKey_(v){if(v instanceof Date)return Utilities.formatDate(v,Session.getScriptTimeZone(),'yyyy-MM-dd');return String(v||'').slice(0,10)}function displayDate_(v){if(v instanceof Date)return Utilities.formatDate(v,Session.getScriptTimeZone(),'yyyy-MM-dd HH:mm:ss');return String(v||'')}
function friendly_(e){const m=e&&e.message?e.message:'Unable to complete the request.';return m.length>240?m.slice(0,240):m}








